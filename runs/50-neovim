#!/usr/bin/env bash
set -euo pipefail

log() {
  printf "[%s] %s\n" "$(date '+%H:%M:%S')" "$*"
}

is_mac() { [[ "${OS:-${OSTYPE:-}}" == darwin* ]]; }

NVIM_VERSION="v0.12.3"

if is_mac; then
  if ! command -v nvim &>/dev/null; then
    log "Installing neovim"
    brew install neovim
  fi
else
  # Always provide our pinned neovim at ~/.local/bin/nvim, which .zsh_profile
  # puts ahead of any distro nvim (e.g. /usr/local/bin/nvim on DGX). Relying on
  # a pre-existing system nvim breaks nvim-treesitter (master branch) with
  # "attempt to call method 'range' (a nil value)".
  nvim_bin="$HOME/.local/bin/nvim"
  installed_version=""
  if [[ -x "$nvim_bin" ]]; then
    installed_version="$("$nvim_bin" --version 2>/dev/null | awk 'NR==1{print $2}')"
  fi

  if [[ "$installed_version" != "$NVIM_VERSION" ]]; then
    case "$(uname -m)" in
      x86_64)        arch="x86_64" ;;
      aarch64|arm64) arch="arm64" ;;
      *) log "Unsupported architecture: $(uname -m)"; exit 1 ;;
    esac
    tarball="nvim-linux-${arch}.tar.gz"
    url="https://github.com/neovim/neovim/releases/download/${NVIM_VERSION}/${tarball}"

    log "Downloading neovim ${NVIM_VERSION} (${arch})"
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "$tmpdir"' EXIT
    curl -fsSL "$url" -o "$tmpdir/$tarball"

    nvim_dir="$HOME/personal/nvim"
    rm -rf "$nvim_dir"
    mkdir -p "$nvim_dir"
    tar -xzf "$tmpdir/$tarball" -C "$nvim_dir" --strip-components=1

    mkdir -p "$HOME/.local/bin"
    ln -sf "$nvim_dir/bin/nvim" "$nvim_bin"
    log "neovim ${NVIM_VERSION} installed to $nvim_bin"
  else
    log "neovim ${NVIM_VERSION} already present at $nvim_bin"
  fi
fi

log "Done"
