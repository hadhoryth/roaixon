#!/usr/bin/env bash
set -euo pipefail

log() {
  printf "[%s] %s\n" "$(date '+%H:%M:%S')" "$*"
}

is_mac() { [[ "${OS:-${OSTYPE:-}}" == darwin* ]]; }

NVIM_VERSION="v0.12.4"

# Install our pinned version unless the resolved nvim already matches it.
# A pre-existing/stale nvim (e.g. a system dev build) must NOT make us skip:
# it may report as the right major.minor yet lack options newer plugins need.
have="$(command -v nvim &>/dev/null && nvim --version 2>/dev/null | head -1 | awk '{print $2}' || true)"
if [[ "$have" == "$NVIM_VERSION" ]]; then
  log "neovim ${NVIM_VERSION} already installed"
else
  [[ -n "$have" ]] && log "found nvim ${have}, installing pinned ${NVIM_VERSION}"
  case "$(uname -m)" in
    x86_64)        arch="x86_64" ;;
    aarch64|arm64) arch="arm64" ;;
    *) log "Unsupported architecture: $(uname -m)"; exit 1 ;;
  esac
  if is_mac; then
    tarball="nvim-macos-${arch}.tar.gz"
  else
    tarball="nvim-linux-${arch}.tar.gz"
  fi
  url="https://github.com/neovim/neovim/releases/download/${NVIM_VERSION}/${tarball}"

  log "Downloading neovim ${NVIM_VERSION} (${arch})"
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' EXIT
  curl -fsSL "$url" -o "$tmpdir/$tarball"

  nvim_dir="$HOME/personal/nvim"
  rm -rf "$nvim_dir"
  mkdir -p "$nvim_dir"
  tar -xzf "$tmpdir/$tarball" -C "$nvim_dir" --strip-components=1
  # Release binaries are unsigned; drop quarantine so Gatekeeper doesn't block them.
  is_mac && xattr -rc "$nvim_dir" 2>/dev/null || true

  mkdir -p "$HOME/.local/bin"
  ln -sf "$nvim_dir/bin/nvim" "$HOME/.local/bin/nvim"
  log "neovim installed to ~/.local/bin/nvim"
fi

# The Neovim 0.12 treesitter plugin uses the CLI to build every parser.
TREE_SITTER_VERSION="0.27.0"
have_ts="$(tree-sitter --version 2>/dev/null | awk '{print $2}' || true)"
if [[ "$have_ts" == "$TREE_SITTER_VERSION" ]]; then
  log "tree-sitter ${TREE_SITTER_VERSION} already installed"
else
  case "$(uname -m)" in
    x86_64)        ts_arch="x64" ;;
    aarch64|arm64) ts_arch="arm64" ;;
    *) log "Unsupported architecture: $(uname -m)"; exit 1 ;;
  esac
  if is_mac; then
    ts_os="macos"
  else
    ts_os="linux"
  fi
  ts_tmpdir="$(mktemp -d)"
  trap 'rm -rf "${tmpdir:-}" "$ts_tmpdir"' EXIT
  log "Downloading tree-sitter ${TREE_SITTER_VERSION} (${ts_arch})"
  curl -fsSL "https://github.com/tree-sitter/tree-sitter/releases/download/v${TREE_SITTER_VERSION}/tree-sitter-${ts_os}-${ts_arch}.gz" -o "$ts_tmpdir/tree-sitter.gz"
  gzip -dc "$ts_tmpdir/tree-sitter.gz" > "$ts_tmpdir/tree-sitter"
  chmod +x "$ts_tmpdir/tree-sitter"
  mkdir -p "$HOME/.local/bin"
  mv "$ts_tmpdir/tree-sitter" "$HOME/.local/bin/tree-sitter"
  "$HOME/.local/bin/tree-sitter" --version
  log "tree-sitter installed to ~/.local/bin/tree-sitter"
fi

log "Done"
