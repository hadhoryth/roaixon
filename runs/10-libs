#!/usr/bin/env bash
set -euo pipefail

log() {
  printf "[%s] %s\n" "$(date '+%H:%M:%S')" "$*"
}

is_mac() { [[ "${OS:-${OSTYPE:-}}" == darwin* ]]; }

install() {
  log "Installing $1"
  if is_mac; then
    brew install "$1"
  else
    sudo apt install -y "$1"
  fi
}

install curl
install git
install ripgrep
install tree
install direnv
install unzip

# Build toolchain (treesitter parsers, telescope-fzf-native) and
# pip/venv for mason-managed tools (ruff, clang-format). clangd comes from the
# distro because mason ships no aarch64 Linux clangd release (fails on DGX).
if ! is_mac; then
  sudo apt install -y build-essential python3-pip python3-venv clangd
fi

# fzf from source
fzf_dir="$HOME/personal/fzf"
if [[ ! -d "$fzf_dir" ]]; then
  log "Cloning fzf"
  git clone --depth 1 https://github.com/junegunn/fzf.git "$fzf_dir"
else
  git -C "$fzf_dir" pull --ff-only || true
fi
"$fzf_dir/install" --bin

# fd (Ubuntu calls it fd-find)
log "Installing fd"
if is_mac; then
  brew install fd
else
  sudo apt install -y fd-find
  mkdir -p "$HOME/.local/bin"
  ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"
fi

log "Done"
