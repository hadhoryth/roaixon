#!/usr/bin/env bash
set -euo pipefail

log() {
  printf "[%s] %s\n" "$(date '+%H:%M:%S')" "$*"
}

is_mac() { [[ "${OS:-${OSTYPE:-}}" == darwin* ]]; }

tmux_plugins_dir="$HOME/personal/tmux/plugins"
tmux_sessions_dir="$HOME/personal/tmux/sessions"

mkdir -p "$tmux_plugins_dir" "$tmux_sessions_dir"

if ! command -v tmux &>/dev/null; then
  log "Installing tmux"
  if is_mac; then
    brew install tmux
  else
    sudo apt install -y tmux
  fi
fi

tpm_dir="$tmux_plugins_dir/tpm"
if [[ ! -d "$tpm_dir" ]]; then
  log "Installing TPM"
  git clone --depth 1 https://github.com/tmux-plugins/tpm "$tpm_dir"
else
  git -C "$tpm_dir" pull --ff-only || true
fi

# Install all plugins declared in tmux.conf (resurrect, catppuccin, ...)
# so the first real tmux launch needs no manual prefix+I.
log "Installing tmux plugins"
started_server=0
if ! tmux has-session 2>/dev/null; then
  tmux start-server
  started_server=1
fi
"$tpm_dir/bin/install_plugins"
if [[ $started_server -eq 1 ]]; then
  tmux kill-server 2>/dev/null || true
fi

log "Done"
