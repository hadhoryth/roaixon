#!/usr/bin/env bash
set -euo pipefail

# OS Detection with override
OS="${OSTYPE:-}"
DRY_RUN=0

usage() {
  cat <<EOF
Usage: ./run [OPTIONS]

Options:
  --mac       Force macOS mode
  --linux     Force Linux mode
  --dry, -n   Dry run (show what would be done)
  --help, -h  Show this help
EOF
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mac)    OS="darwin"; shift ;;
    --linux)  OS="linux-gnu"; shift ;;
    --dry|-n) DRY_RUN=1; shift ;;
    --help|-h) usage ;;
    *) echo "Unknown option: $1"; usage ;;
  esac
done

# Export for child scripts
export OS DRY_RUN

log() { printf '%s\n' "$*"; }
dry() { [[ $DRY_RUN -eq 1 ]]; }
run() {
  if dry; then
    printf '[DRY_RUN] %s\n' "$*"
  else
    "$@"
  fi
}
is_mac() { [[ "$OS" == darwin* ]]; }

script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

install_brew() {
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
}

prereqs() {
  if is_mac; then
    if [[ ! -x /opt/homebrew/bin/brew && ! -x /usr/local/bin/brew ]]; then
      log "Installing Homebrew..."
      run install_brew
    fi
    # Put brew on PATH for this run and every child script
    if [[ -x /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
      eval "$(/usr/local/bin/brew shellenv)"
    fi
  else
    run sudo apt-get update
  fi
}

copy_config() {
  local config_dir="$HOME/.config"
  local dev_config_dir="$script_dir/env/.config"

  log "Copying config to $config_dir..."
  run mkdir -p "$config_dir"

  # Copy each subdirectory explicitly to avoid nested .config.
  # Existing non-roaixon configs are backed up once to <dir>.pre-roaixon;
  # after that each run replaces the dir so stale files never linger.
  for dir in "$dev_config_dir"/*/; do
    [[ -d "$dir" ]] || continue
    local name target backup
    name="$(basename "${dir%/}")"
    target="$config_dir/$name"
    backup="$target.pre-roaixon"
    if [[ -d "$target" ]]; then
      if [[ ! -e "$backup" ]]; then
        log "Backing up $target -> $backup"
        run mv "$target" "$backup"
      else
        run rm -rf "$target"
      fi
    fi
    run cp -r "${dir%/}" "$config_dir/"
  done
}

copy_zsh_config() {
  local dest_dir="$HOME/personal"
  local src_dir="$script_dir/env"

  log "Copying zsh config to $dest_dir..."
  run mkdir -p "$dest_dir"

  for f in "$src_dir"/.*zsh*; do
    [[ -f "$f" ]] && run cp "$f" "$dest_dir/"
  done
}

run_executables() {
  local runs_dir="$script_dir/runs"

  if [[ -d "$runs_dir" ]]; then
    for s in "$runs_dir"/*; do
      [[ -f "$s" && -x "$s" ]] || continue
      log "Running: $(basename "$s")"
      run "$s"
    done
  else
    log "No runs directory at $runs_dir (skipping)"
  fi
}

log "Detected OS: $OS"
prereqs
copy_config
copy_zsh_config
run_executables

if ! dry; then
  printf '\n✓ Done! Activate environment with:\n'
  printf '  source "%s/personal/.zshrc"\n' "$HOME"
fi
